{
  "name": "banco-techo",
  "version": "1.0.0",
  "description": "Detector de patrones de fraude (card testing) con un Autómata Finito Determinista — Proyecto de Teoría de la Computación",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node server/server.js",
    "dev": "node --watch server/server.js",
    "ataque": "node scripts/card-tester.js",
    "pruebas": "node scripts/probar-afd.js",
    "test": "node scripts/pipeline.js",
    "test:dev": "node --test \"test/dev/**/*.test.js\"",
    "test:qa": "node --test \"test/qa/**/*.test.js\"",
    "test:uat": "node --test \"test/uat/**/*.test.js\""
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright-core": "^1.65.0"
  }
}
